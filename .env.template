# Template for Sandbox Agent environment keys.
# Duplicate this file to '.env' and fill in your absolute API keys.

# Google Gemini API Key (OpenAI-compatible endpoints will try this if OpenAI key is empty)
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Sandbox Container Ports to map to Host
HOST_PORT_JUPYTER=8888
HOST_PORT_TENSORBOARD=6006
HOST_PORT_API=8000
